# Application
APP_ENV=prod
APP_NAME=competitive-agent-system
# 生产环境必须修改为足够长、不可猜测的随机字符串，用于认证相关签名。
AUTH_SECRET_KEY=please-change-to-a-long-random-secret

# Build mirrors
# 默认针对腾讯云 CVM 优化；如果部署在其他云厂商，可以替换为对应云厂商镜像源或官方源。
# 官方源示例见 DEPLOY_DOCKER.md。
APT_DEBIAN_MIRROR=http://mirrors.tencentyun.com/debian
APT_DEBIAN_SECURITY_MIRROR=http://mirrors.tencentyun.com/debian-security
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/

# MySQL
# Compose 会启动内置 MySQL 容器。应用容器通过服务名 mysql 访问数据库。
MYSQL_ROOT_PASSWORD=please-change-root-password
MYSQL_DATABASE=competitor_agent
MYSQL_USER=competitor_agent
MYSQL_PASSWORD=please-change-app-password
# 注意：DATABASE_URL 里的用户名、密码、数据库名需要和上面的 MYSQL_USER、MYSQL_PASSWORD、MYSQL_DATABASE 保持一致。
DATABASE_URL=mysql+pymysql://competitor_agent:please-change-app-password@mysql:3306/competitor_agent?charset=utf8mb4

# Redis / Celery
# Compose 会启动内置 Redis 容器。Redis 不映射宿主机端口，不会和宿主机 systemctl Redis 冲突。
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Milvus
# Compose 会启动内置 Milvus standalone。应用容器通过服务名 milvus 访问。
# 当前 milvus/user.yaml 开启了鉴权，默认 standalone 初始账号为 root/Milvus。
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=evidence_chunks
# 以下端口只影响宿主机访问 Milvus，不影响容器内部的 MILVUS_URI。
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# MinIO
# MinIO 是 Milvus standalone 的对象存储依赖。生产环境请修改默认账号密码。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Firecrawl
# Firecrawl API Key。不要把真实 Key 提交到 Git；真实值只写入服务器上的 .env.docker。
FIRECRAWL_API_KEY=
# 每条 Firecrawl 搜索 query 最多返回多少条搜索结果；数值越大，候选资料越多，但抓取与处理时间也会增加。
FIRECRAWL_SEARCH_RESULTS_PER_QUERY=3
# 每个竞品在一轮资料采集中最多抓取多少个新 URL；用于限制单个竞品的采集规模，0 表示不限制。
FIRECRAWL_MAX_URLS_PER_COMPETITOR=30

# LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# 是否启用推理/思考类模型参数。具体是否生效取决于模型供应商。
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=high

# Embedding
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度必须和实际 Embedding 模型输出维度一致，否则 Milvus 入库/检索会失败。
EMBEDDING_DIM=1536

# Collector / Evidence pipeline
# 资料采集并发数。数值越大速度越快，但会增加外部 API、网络和服务器压力。
COLLECTOR_MAX_WORKERS=8
# 证据抽取并发数。
EVIDENCE_EXTRACTOR_MAX_WORKERS=4
# 证据向量化批大小。数值越大吞吐越高，但单次请求和内存压力也越大。
EVIDENCE_EMBEDDING_BATCH_SIZE=8

# QA
# QA 不通过时最多自动返工/重跑轮数；0 表示不自动返工，1 表示最多返工 1 轮。
QA_MAX_REVISION_ROUNDS=5
# 报告总结 Agent 内部 grounding QA 不通过时，最多自动重写全局总结 section 的次数；0 表示只检查不重写。
REPORT_FINALIZER_MAX_REVISION_ROUNDS=5
# 任一核心分析维度 QA 分数低于该阈值时，最终 QA 状态不能标记为通过。
QA_DIMENSION_PASS_THRESHOLD=0.70
# 报告总结 Agent 的 grounding QA 分数低于该阈值时，最终 QA 状态不能标记为通过。
QA_FINALIZER_PASS_THRESHOLD=0.75

# Task execution / Celery fallback
# false 表示任务通过 Celery Worker 异步执行；生产环境建议保持 false。
RUN_TASKS_INLINE=false
# Celery 调用异常时，是否允许 API 进程回退到本地线程执行任务。
FALLBACK_TO_LOCAL_THREAD_ON_CELERY_ERROR=true
# Worker 不可用时，是否允许 API 进程回退到本地线程执行任务。
FALLBACK_TO_LOCAL_THREAD_WHEN_WORKER_UNAVAILABLE=true
# Worker 心跳过期时间，超过该时间未更新则视为 Worker 可能不可用。
CELERY_WORKER_HEARTBEAT_TTL_SECONDS=45
# Worker 心跳上报间隔。
CELERY_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# Celery Redis visibility timeout。
CELERY_VISIBILITY_TIMEOUT_SECONDS=120
# 队列任务超过该时间仍未恢复时，可进入恢复逻辑。
CELERY_QUEUED_RECOVERY_MAX_AGE_SECONDS=1800

# Web
# 前端 Nginx 容器映射到宿主机的端口。默认 http://服务器IP/ 访问。
WEB_PORT=80
